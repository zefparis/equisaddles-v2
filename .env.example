# ==============================================
# FICHIER EXEMPLE DE CONFIGURATION .env
# POUR EQUI SADDLES E-COMMERCE APPLICATION
# ==============================================
#
# ATTENTION: Ne jamais committer de vraies clés API !
# Ce fichier sert uniquement d'exemple pour la configuration.

# ==============================================
# CONFIGURATION DATABASE (PostgreSQL)
# ==============================================
DATABASE_URL=postgresql://user:password@host:5432/database

# ==============================================
# CONFIGURATION STRIPE PAYMENTS
# ==============================================
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
VITE_STRIPE_PUBLIC_KEY=pk_test_placeholder

# ==============================================
# CONFIGURATION EMAIL (BREVO)
# ==============================================
BREVO_API_KEY=placeholder

# ==============================================
# CONFIGURATION SÉCURITÉ
# ==============================================
SESSION_SECRET=generate-a-random-secret-at-least-32-characters

# ==============================================
# CONFIGURATION ADMIN
# ==============================================
ADMIN_USERNAME=change-me
ADMIN_PASSWORD_HASH=generate-an-argon2id-hash

# ==============================================
# CONFIGURATION ENVIRONNEMENT
# ==============================================
NODE_ENV=production
PORT=8080

# ==============================================
# CONFIGURATION APPLICATION
# ==============================================
VITE_APP_NAME=Equi Saddles
VITE_APP_URL=https://your-domain.example.com

# ==============================================
# INFORMATIONS ENTREPRISE
# ==============================================
COMPANY_NAME=Equi Saddles
COMPANY_ADDRESS=Rue du Vicinal 9, 4141 Louveigné, Belgique
COMPANY_PHONE=+32 496 94 41 25
COMPANY_VAT=BE0542650464
CONTACT_EMAIL=contact@equisaddles.com

# ==============================================
# CONFIGURATION UPLOAD FICHIERS & CLOUDINARY
# ==============================================
MAX_FILE_SIZE=10485760
CLOUDINARY_CLOUD_NAME=placeholder
CLOUDINARY_API_KEY=placeholder
CLOUDINARY_API_SECRET=placeholder
UPLOAD_DIR=public/uploads

# ==============================================
# CONFIGURATION SÉCURITÉ RÉSEAU
# ==============================================
CORS_ORIGIN=https://your-domain.example.com
TRUST_PROXY=true

# ==============================================
# CONFIGURATION LOGS
# ==============================================
LOG_LEVEL=info